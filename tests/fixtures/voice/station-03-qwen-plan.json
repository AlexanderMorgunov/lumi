          "language": "English",
          "spokenText": "are.",
          "jobId": "marta-en-303a72939a2ca51f"
        },
        {
          "rawText": ". Это форма глагола ",
          "language": "Russian",
          "spokenText": "Это форма глагола",
          "jobId": "marta-ru-9b5e6d124fffd76c"
        },
        {
